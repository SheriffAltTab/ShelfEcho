# ShelfEcho API — copy to `server/.env` for local development.

PORT=3001
HOST=0.0.0.0
JWT_SECRET=change-me-in-production

# Allowed CORS origins are built-in for localhost + https://shelfecho.site; add more if needed:
FRONTEND_URL=https://shelfecho.site

# --- Email (AWS SES SMTP or compatible provider) ---
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI in Google Cloud Console, e.g.:
# https://api.yourdomain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
