# ShelfEcho API — copy to `server/.env` for local development.

PORT=3001
HOST=0.0.0.0
JWT_SECRET=change-me-in-production

FRONTEND_URL=https://shelfecho.site

# =============================================================================
# Google OAuth (Passport + passport-google-oauth20)
# =============================================================================
# Get GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from:
#   Google Cloud Console → APIs & Services → Credentials → Create credentials
#   → OAuth client ID → Application type "Web application"
# Under "Authorized redirect URIs" add EXACTLY the same URL as GOOGLE_REDIRECT_URI below
# (e.g. http://localhost:3001/api/auth/google/callback for local API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# =============================================================================
# Email — Option A: Gmail (recommended for dev / small projects)
# =============================================================================
# Use the SAME mailbox for sending (e.g. sheriffalttab@gmail.com).
# You CANNOT use your normal Gmail password here.
# Steps:
#   1) account.google.com → Security → turn on 2-Step Verification
#   2) Security → App passwords → create password for "Mail"
#   3) GMAIL_USER = full email, GMAIL_APP_PASSWORD = 16-character app password (spaces optional)
# EMAIL_FROM defaults to GMAIL_USER if unset.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# =============================================================================
# Email — Option B: generic SMTP (Amazon SES, SendGrid, etc.)
# =============================================================================
# If GMAIL_USER + GMAIL_APP_PASSWORD are set, Gmail transport is used and these are ignored.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
