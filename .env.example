# Copy to `.env` for local Vite overrides (optional in dev — Vite proxies /api to the backend).
# Production: set these in the build environment (e.g. GitHub Actions secrets, Amplify, or shell before `npm run build`).

# API origin without trailing slash. May include `/api` suffix; the client normalizes baseURL.
# Example production: https://shelfecho.site/api
VITE_API_URL=http://localhost:3001
